# ==============================================================================
# Kyberna — Variáveis de Ambiente (.env)
# Copie este arquivo para .env e preencha com as suas configurações locais
# ==============================================================================

# Ambiente de execução: dev | ci | prod
KYBERNA_ENV=dev

# Mecanismo de dados para o App: auto | azure_sql | duckdb
# - auto: tenta Azure SQL com timeout de 8s; se indisponível/pausado, cai para DuckDB local
# - azure_sql: força conexão com Azure SQL Database
# - duckdb: modo 100% offline servindo snapshots locais Parquet / DuckDB
KYBERNA_DATA_BACKEND=auto

# Diretório base para armazenamento de dados local (padrão: data/)
# KYBERNA_DATA_DIR=data
# KYBERNA_DUCKDB_PATH=data/kyberna.duckdb

# Azure Data Lake Storage Gen2 (Parquet remoto)
# KYBERNA_LAKE_URI=abfss://lake@stkybernaprod.dfs.core.windows.net

# Azure SQL Database (Serverless Gen5 Free Tier)
# KYBERNA_AZURE_SQL_SERVER=sql-kyberna-prod.database.windows.net
# KYBERNA_AZURE_SQL_DATABASE=sqldb-kyberna
# KYBERNA_AZURE_SQL_AUTH=token
# KYBERNA_AZURE_SQL_CONNECT_TIMEOUT_S=8
# KYBERNA_AZURE_SQL_USER=
# KYBERNA_AZURE_SQL_PASSWORD=

# API Socrata (Iowa Liquor Sales)
# Obtenha um App Token gratuito em https://data.iowa.gov/profile/edit/developer_settings
KYBERNA_SOCRATA_APP_TOKEN=

# Data âncora da demonstração comercial (AAAA-MM-DD)
# Se omitido, assume o dia de ontem automaticamente
# KYBERNA_REFERENCE_DATE=2026-10-28

# Senha de proteção para a demonstração comercial do Streamlit
KYBERNA_APP_PASSWORD=kyberna2026
